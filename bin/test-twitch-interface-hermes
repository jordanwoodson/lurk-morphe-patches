#!/usr/bin/env python3
"""Compile production UI transforms and execute emitted Hermes caller probes."""
from pathlib import Path
import os
import subprocess
import sys

repo = Path(__file__).resolve().parents[1]
work = Path(os.environ.get("MORPHE_WORK", Path.home() / "build/lurk-morphe-patches"))
root = work / "twitch-interface"
root.mkdir(parents=True, exist_ok=True)
libraries = sorted((Path.home() / ".gradle/wrapper/dists").glob("gradle-*/**/lib/kotlin-compiler-embeddable-*.jar"))
if not libraries:
    raise SystemExit("Use the repository's Gradle wrapper once to provide its existing Kotlin compiler")
classpath = os.pathsep.join(map(str, libraries[-1].parent.glob("*.jar")))
stub = root / "PatchException.kt"
stub.write_text('package app.morphe.patcher.patch\nclass PatchException(message: String): RuntimeException(message)\n')
sources = [repo / "patches/src/main/kotlin/io/github/jordanwoodson/patches/twitch/shared/Hermes.kt",
           repo / "patches/src/main/kotlin/io/github/jordanwoodson/patches/twitch/clips/HermesInterface.kt",
           repo / "tests/twitch/InterfaceHermesProbe.kt", repo / "tests/twitch/InterfaceClipNavigationProbe.kt", stub]
java = str(Path(os.environ["JAVA_HOME"]) / "bin/java") if os.environ.get("JAVA_HOME") else "java"
commands = [[java, "-cp", classpath, "org.jetbrains.kotlin.cli.jvm.K2JVMCompiler", "-no-stdlib", "-no-reflect",
             "-classpath", classpath, "-d", str(root / "interface-probe.jar"), *map(str, sources)],
            [java, "-cp", str(root / "interface-probe.jar") + os.pathsep + classpath,
             "io.github.jordanwoodson.patches.twitch.clips.InterfaceHermesProbeKt",
             sys.argv[1] if len(sys.argv) > 1 else str(work / "twitch/31.7.0/apktool/assets/index.android.bundle"),
             str(root / "interface.bundle"), str(root / "interface-manifest.json"), *sys.argv[2:]]]
for command in commands:
    result = subprocess.run(command)
    if result.returncode:
        raise SystemExit(result.returncode)
