#!/usr/bin/env bash
# Run the Rumble integration probes against an APK on the scratch emulator.
# Usage: bash bin/test-rumble <base-or-patched.apk> [Probe ...]
# With no probe names, every tests/rumble/*Probe.java runs, then tests/rumble/verify_compose.py (the Compose
# trace labels and App Info rows the patches rely on) and the extension hooks of the included patches
# (tests/rumble/expected-hooks.txt) are checked in the APK's dex.
source "$(dirname "$0")/lib/common.sh"

[[ $# -ge 1 && -f "$1" ]] || die "usage: bash bin/test-rumble <base-or-patched.apk> [Probe ...]"
apk="$1"; shift
serial=${ANDROID_SERIAL:-emulator-5580}
out="$WORK/tests/rumble"
remote=/data/local/tmp/morphe-rumble-test
rm -rf "$out/classes" "$out/dex"
mkdir -p "$out/classes" "$out/dex" "$WORK/tmp"
export TMPDIR="$WORK/tmp"

if [[ $# -gt 0 ]]; then
    probes=("$@")
else
    probes=()
    for f in "$ROOT"/tests/rumble/*Probe.java; do probes+=("$(basename "$f" .java)"); done
fi
for probe in "${probes[@]}"; do
    [[ -f "$ROOT/tests/rumble/$probe.java" ]] || die "no tests/rumble/$probe.java"
done

# Probes compile against the Android SDK (org.json); the app's classes are only reached by reflection.
javac --release 11 -classpath "$ANDROID_HOME/platforms/android-36/android.jar" -d "$out/classes" "$ROOT"/tests/rumble/*.java
"$(build_tool d8)" --min-api 26 --output "$out/dex" $(find "$out/classes" -name '*.class')
(cd "$out/dex" && jar cf "$out/probe.jar" classes.dex)

# The explicit emulator serial prevents installing or running tests on a connected phone.
adb -s "$serial" shell mkdir -p "$remote"
trap 'adb -s "$serial" shell rm -rf "$remote" >/dev/null 2>&1 || true' EXIT
adb -s "$serial" push "$apk" "$remote/app.apk" >/dev/null
adb -s "$serial" push "$out/probe.jar" "$remote/probe.jar" >/dev/null
failed=0
for probe in "${probes[@]}"; do
    note "$probe"
    adb -s "$serial" shell "CLASSPATH=$remote/probe.jar:$remote/app.apk app_process /system/bin $probe" || failed=1
done

# With every probe run, also check that app code calls each hook of the included patches: Morphe drops an
# injected non-range invoke above v15 without an error. The stock APK has no hooks to check.
if [[ $# -eq 0 ]]; then
    note "Compose trace labels and App Info rows"
    python3 -I "$ROOT/tests/rumble/verify_compose.py" "$apk" || failed=1
    hooks="$(python3 -I "$ROOT/tests/rumble/expected_hooks.py" "$apk")"
    if [[ -n "$hooks" ]]; then
        note "extension hooks"
        # shellcheck disable=SC2086
        python3 -I "$ROOT/tests/verify_extension_calls.py" "$apk" $hooks || failed=1
        note "settings read by code"
        python3 -I "$ROOT/tests/rumble/verify_switch_reads.py" "$apk" || failed=1
    fi
fi
exit $failed
